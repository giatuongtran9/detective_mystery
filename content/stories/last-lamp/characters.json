{
  "characters": {
    "Ottley": {
      "name": "Sergeant Pip Ottley",
      "role": "Watch sergeant",
      "npc": true,
      "portrait": "p-ottley",
      "topics": [
        {
          "id": "who",
          "label": "Who found him?",
          "beats": [
            {
              "y": "Who found him?"
            },
            {
              "s": "Ottley",
              "t": "\"The butler, Mr. Pell, and a footman, Hob Larkin. They forced the door at twenty to twelve. Mr. Pell shut off the gas and opened the shutters, which I gather was the right thing to do.\""
            }
          ]
        },
        {
          "id": "chain",
          "label": "Ask if there is anything else on the body.",
          "when": {
            "$fn": "() => has(\"C03\") && has(\"C04\")"
          },
          "hideIf": {
            "$fn": "() => flag(\"chain\")"
          },
          "beats": [
            {
              "y": "Was anything else found on the Master?"
            },
            {
              "s": "Ottley",
              "t": "\"Inspector. The Master's watch-chain, from his waistcoat. I should have handed it over sooner.\""
            },
            {
              "n": "It is heavy gold. The ring on it holds one small key, and a bare loop where a larger one once hung."
            }
          ],
          "fx": {
            "flag": {
              "chain": true
            },
            "item": "chain"
          }
        },
        {
          "id": "hint",
          "label": "Ask Ottley for a hint.",
          "hint": true
        }
      ]
    },
    "Pell": {
      "name": "Tobias Pell",
      "role": "Butler",
      "rel": "Nineteen years in the Vennard household.",
      "portrait": "p-pell",
      "startSus": 5,
      "facts": [
        {
          "t": "Butler at Vennard House for nineteen years. Quiet, formal, punctual.",
          "c": {
            "$fn": "() => true"
          }
        },
        {
          "t": "Says he trimmed the study lamp at five: \"ten minutes' work\".",
          "c": {
            "$fn": "() => asked(\"Pell\", \"tell_me_about_the_study_lamp\")"
          }
        },
        {
          "t": "Says he knows \"wicks and mantles, not pipes\".",
          "c": {
            "$fn": "() => asked(\"Pell\", \"you_know_lamps\")"
          }
        },
        {
          "t": "Signed out the spare study key from 4:50 to 5:25 PM: thirty-five minutes.",
          "c": {
            "$fn": "() => has(\"C16\")"
          }
        },
        {
          "t": "Was at the study door at 10:25 and announced the Master 'indisposed' at 10:32. The cook puts him in the kitchen from 9:15.",
          "c": {
            "$fn": "() => has(\"C13\") && has(\"C19\")"
          }
        },
        {
          "t": "Trained as an apprentice fitter, 1145 to 1150. His brother Josiah was the foreman blamed for Cinder Row.",
          "c": {
            "$fn": "() => has(\"C24\")"
          }
        },
        {
          "t": "Was taught the Old Pattern method of pinning a valve strip.",
          "c": {
            "$fn": "() => has(\"C26\")"
          }
        },
        {
          "t": "Collected a wire from Commissioner Loam in person, read it twice, and left white as chalk.",
          "c": {
            "$fn": "() => has(\"C34\")"
          }
        },
        {
          "t": "Has asked to see the 1166 inquiry file every anniversary of the fire.",
          "c": {
            "$fn": "() => has(\"C37\")"
          }
        }
      ],
      "topics": [
        {
          "id": "tell_me_about_the_study_lamp"
        },
        {
          "id": "you_know_lamps"
        },
        {
          "id": "what_do_you_make_of_the_fire_of_sixty_si"
        },
        {
          "id": "where_were_you_tonight"
        },
        {
          "id": "did_anyone_see_you_at_half_past_ten"
        },
        {
          "id": "tell_me_again_about_half_past_ten",
          "when": {
            "$fn": "() => has(\"C39\")"
          },
          "fx": {
            "flag": {
              "slip": true
            }
          }
        },
        {
          "id": "room",
          "label": "Ask his leave to look at his room.",
          "disabled": {
            "$fn": "() => groundsCount() < 3 ? \"You have no grounds to search his room yet.\" : (!flag(\"consent\") ? \"You need the household's consent: Lady Cordelia or Miss Odalys.\" : null)"
          },
          "hideIf": {
            "$fn": "() => flag(\"roomOpen\")"
          },
          "beats": [
            {
              "y": "I'd like to see your room."
            },
            {
              "s": "Pell",
              "t": "\"By all means, Inspector. I'd only ask that you leave the bed as it is.\""
            },
            {
              "n": "<i>The way up to his room is now open to you.</i>"
            }
          ],
          "fx": {
            "flag": {
              "roomOpen": true
            }
          }
        }
      ],
