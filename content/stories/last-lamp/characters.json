    "Odalys": {
      "name": "Odalys Vennard",
      "role": "Chief accountant and works manager",
      "rel": "The Master's daughter, by his first wife Marguerite.",
      "portrait": "p-odalys",
      "startSus": 20,
      "facts": [
        {
          "t": "Chief accountant. Daughter of the Master's first wife, whose dowry founded the Works.",
          "c": {
            "$fn": "() => true"
          }
        },
        {
          "t": "Says she was at the Works from twenty past eight until ten past six and reached the house by a quarter to seven.",
          "c": {
            "$fn": "() => asked(\"Odalys\", \"where_were_you_today\")"
          }
        },
        {
          "t": "Quarrelled with her father at ten to nine over the sale of 'Mother's works'.",
          "c": {
            "$fn": "() => has(\"C12\")"
          }
        },
        {
          "t": "Booked the extra maid 'Ida March' two weeks before the gala.",
          "c": {
            "$fn": "() => has(\"C11\")"
          }
        },
        {
          "t": "Has known about the sale for three weeks.",
          "c": {
            "$fn": "() => asked(\"Odalys\", \"you_argued_with_your_father_at_ten_to_ni\")"
          }
        },
        {
          "t": "Signed in at the Works at 8:20 AM and out at 6:10 PM.",
          "c": {
            "$fn": "() => has(\"C23\")"
          }
        },
        {
          "t": "Wrote to Ilsa Marrow: 'Come as a maid on the ninth… Bring me back what he took.'",
          "c": {
            "$fn": "() => has(\"C30\")"
          }
        }
      ],
