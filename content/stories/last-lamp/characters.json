      "name": "Lady Cordelia Vennard",
      "role": "The Master's second wife",
      "rel": "Stepmother to Odalys, only four years older.",
      "portrait": "p-cordelia",
      "startSus": 20,
      "facts": [
        {
          "t": "The Master's second wife. Grief performed a beat too perfectly.",
          "c": {
