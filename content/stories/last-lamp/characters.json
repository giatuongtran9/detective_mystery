      },
      "studyIntro": [
        {
          "n": "Ottley fetches Mr. Pell from the servants' hall. He arrives within a minute, coat brushed, and stands just inside the door without once looking at the settee."
        },
        {
          "s": "Pell",
          "t": "\"You've had a wet night of it, Inspector. If I may.\""
        }
      ]
