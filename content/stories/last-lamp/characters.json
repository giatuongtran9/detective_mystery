    "Corvane": {
      "name": "Bastian Corvane",
      "role": "Junior partner and chief engineer",
      "rel": "The Master's partner; designer of the Safe-Valve.",
      "portrait": "p-corvane",
      "startSus": 25,
      "facts": [
        {
          "t": "Junior partner, chief engineer, designer of the Safe-Valve. Charming; taps his signet ring when he lies.",
          "c": {
            "$fn": "() => true"
          }
        },
        {
          "t": "Says he knew nothing of any sale.",
          "c": {
            "$fn": "() => asked(\"Corvane\", \"you_knew_about_the_sale_of_the_works\")"
          }
        },
        {
          "t": "The toast would have struck him from the Works, and his consultancy in the contract is struck through in red.",
          "c": {
            "$fn": "() => has(\"C05\") || has(\"C10\")"
          }
        },
        {
          "t": "Slipped onto the terrace with Halvard Stenn of the Osterhal League from 9:45 to 10:05.",
          "c": {
            "$fn": "() => has(\"C14\")"
          }
        },
        {
          "t": "Was taught the old strip-pinning method.",
          "c": {
            "$fn": "() => has(\"C26\") || asked(\"Corvane\", \"do_you_know_the_old_strip_pinning_method\")"
          }
        },
        {
          "t": "At the Lampworks from 6:10 AM until 5:35 PM, and in the library under the footman's eye from six to seven.",
          "c": {
            "$fn": "() => has(\"C23\") || has(\"C17\")"
          }
        },
        {
          "t": "Stenn wired him that his League board seat follows the Master's signature.",
          "c": {
            "$fn": "() => has(\"C35\")"
          }
        }
      ],
      "topics": [
