    "Quillon": {
      "name": "Dr. Ferris Quillon",
      "role": "Family physician",
      "rel": "The Master's physician and creditor's debtor.",
      "portrait": "p-quillon",
      "startSus": 20,
      "facts": [
        {
          "t": "Family physician; owns the Quillon Infirmary on Ashlar Street. Smooth, evasive, drenched in clove.",
          "c": {
            "$fn": "() => true"
          }
        },
        {
          "t": "Says he never left the ballroom, and pronounced 'apoplexy'.",
          "c": {
            "$fn": "() => asked(\"Quillon\", \"where_were_you_tonight\") || asked(\"Quillon\", \"what_did_you_tell_the_household_about_th\")"
          }
        },
        {
          "t": "Owes the Master 1,200 crowns, due at month-end.",
          "c": {
            "$fn": "() => has(\"C28\")"
          }
        },
        {
          "t": "Meets Lady Cordelia weekly on Ashlar Street; the Master knew and meant to confront them after the gala.",
          "c": {
            "$fn": "() => has(\"C06\")"
          }
        },
        {
          "t": "Was alone with Lady Cordelia under the palms from 9:35 to 10:05.",
          "c": {
            "$fn": "() => has(\"C15\")"
          }
        },
        {
          "t": "At the infirmary from 4:30 to 5:50 PM, then by cab to Marrowgate with Lady Cordelia.",
          "c": {
            "$fn": "() => has(\"C27\")"
          }
        },
        {
          "t": "Knew the Master could not smell gas.",
          "c": {
            "$fn": "() => has(\"C29\")"
          }
        }
      ],
