    "Ilsa": {
      "name": "Ilsa Marrow",
      "role": "Inventor and lamp-repairer ('Ida March')",
      "rel": "Daughter of Emmeric Marrow, whose mantle design the Master patented.",
      "portrait": "p-ilsa",
      "startSus": 15,
      "hostile": [
        {
          "s": "Ilsa",
          "t": "\"I'm at my bench. I was here all day. I've never set foot in that house.\""
        }
      ],
      "facts": [
        {
          "t": "Runs a workshop on Tinkers' Row. Brass burns on her hands.",
          "c": {
            "$fn": "() => true"
          }
        },
        {
          "t": "Her father Emmeric drew the mantle design the Master filed as a Works patent.",
          "c": {
            "$fn": "() => has(\"C09\") || has(\"C30\")"
          }
        },
        {
          "t": "Entered the study by the French window at 6:35 and left at 6:50, disguised as the maid 'Ida March'.",
          "c": {
            "$fn": "() => has(\"C07\") && has(\"C11\")"
          }
        },
        {
          "t": "Says the union was already packed with wax under a crooked collar when she saw it.",
          "c": {
            "$fn": "() => has(\"C32\")"
          }
        },
        {
          "t": "Owns only smooth-jaw spanners. Her chain-wrench is in pawn.",
          "c": {
            "$fn": "() => has(\"C31\")"
          }
        },
        {
          "t": "Her father's fitter's kit was sold in 1183.",
